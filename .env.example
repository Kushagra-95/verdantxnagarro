HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/carbon.db
PUE=1.4
EMBODIED_G_PER_RUN=0
SAVINGS_THRESHOLD_PCT=5
SAVINGS_THRESHOLD_G=5
SAFETY_BUFFER_MIN=15
SYNTHETIC_SEED=42
# Optional: complete coverage is required; otherwise use labeled synthetic data.
CARBON_PROVIDER=auto
RECORDED_CARBON_PATH=app/providers/recordings/gb-recorded.json
ELECTRICITY_MAPS_TOKEN=
PROVIDER_TIMEOUT_SECONDS=3
PROVIDER_RETRIES=1
PROVIDER_CACHE_SECONDS=300
# Optional explanation only. Disabled by default; never changes decisions.
ENABLE_LLM_EXPLANATIONS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local identity: set before FIRST start (12+ chars), or read the generated bootstrap file.
VERDANT_ADMIN_PASSWORD=
# True when served behind HTTPS; leave false for localhost HTTP.
SESSION_COOKIE_SECURE=false
# New environment credentials: /admin shows the exact variable name. Never share one implicitly.
# VERDANT_EM_TOKEN_<ENVIRONMENT_UUID_WITH_UNDERSCORES_UPPERCASE>=
# Authenticated platform disables optional external LLM narration pending scoped client consent.
# Optional smoke script: explicitly choose a disposable environment.
# SMOKE_USERNAME=admin
# SMOKE_PASSWORD=
# SMOKE_ENVIRONMENT_ID=env-default
